{
  "mcpServers": {
    "apple": {
      "command": "npx",
      "args": [
        "-y",
        "@chrischall/aws-mcp"
      ],
      "env": {
        "APPLE_TEAM_ID": "${APPLE_TEAM_ID}",
        "APPLE_KEY_ID": "${APPLE_KEY_ID}",
        "APPLE_PRIVATE_KEY": "${APPLE_PRIVATE_KEY}",
        "APPLE_MUSIC_USER_TOKEN": "${APPLE_MUSIC_USER_TOKEN}",
        "APPLE_MUSIC_WEB_USER_TOKEN": "${APPLE_MUSIC_WEB_USER_TOKEN}",
        "APPLE_WEATHERKIT_SERVICE_ID": "${APPLE_WEATHERKIT_SERVICE_ID}",
        "ICLOUD_USERNAME": "${ICLOUD_USERNAME}",
        "ICLOUD_APP_PASSWORD": "${ICLOUD_APP_PASSWORD}",
        "DISPLAY_TZ": "${DISPLAY_TZ}"
      }
    }
  }
}
